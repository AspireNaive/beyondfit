  {
   "name": "Auth",
   "description": "Run \"Login\" first: its test script stores accessToken in the collection variable {{token}}, which every protected request sends as Bearer.",
   "item": [
    {
     "name": "Login",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "login"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"member@kedemlife.app\",\n  \"password\": \"kedemlife\",\n  \"portal\": \"member\",\n  \"rememberMe\": true\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      },
      "description": "Demo accounts (password kedemlife): member@ (portal member), coach@ (portal coach), admin@ and manager@ (portal admin). Rate limit 30 / 15 min / IP."
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('login ok', () => pm.response.to.have.status(200));",
         "const json = pm.response.json();",
         "pm.collectionVariables.set('token', json.accessToken);",
         "pm.collectionVariables.set('refreshToken', json.refreshToken);",
         "pm.collectionVariables.set('memberId', json.user.id);",
         "pm.collectionVariables.set('tenantId', json.tenant.id);"
        ]
       }
      }
     ]
    },
    {
     "name": "Register",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "register"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"firstName\": \"Jordan\",\n  \"lastName\": \"Lee\",\n  \"email\": \"jordan.lee+{{$timestamp}}@example.com\",\n  \"password\": \"longenough2\",\n  \"phone\": \"+1 555 010 0100\",\n  \"goal\": \"Run a 10k\",\n  \"tenantSlug\": \"ironworks\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      },
      "description": "Creates a member in the named studio (default studio when tenantSlug is omitted) and signs them in. 409 email_taken / seats_full, 422 weak password."
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('session issued', () => pm.response.to.have.status(pm.response.code === 201 ? 201 : 200));",
         "const json = pm.response.json();",
         "if (json && json.accessToken) {",
         "  pm.collectionVariables.set('token', json.accessToken);",
         "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
         "  if (json.user) pm.collectionVariables.set('memberId', json.user.id);",
         "  if (json.tenant) pm.collectionVariables.set('tenantId', json.tenant.id);",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Me",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/auth/me",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "me"
       ]
      },
      "description": "Fresh user + tenant for the token; no tokens re-issued."
     },
     "response": []
    },
    {
     "name": "Update profile",
     "request": {
      "method": "PATCH",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/me",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "me"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"firstName\": \"Jordan\",\n  \"bio\": \"Weekend trail runner.\",\n  \"location\": \"Beacon, NY\",\n  \"phone\": null\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "description": "All fields optional; null clears phone, avatarUrl, title, bio, location. Returns UserProfile."
     },
     "response": []
    },
    {
     "name": "Refresh token",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/refresh",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "refresh"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      },
      "description": "Rotates the refresh token: the presented one is revoked (401 if reused)."
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('session issued', () => pm.response.to.have.status(pm.response.code === 201 ? 201 : 200));",
         "const json = pm.response.json();",
         "if (json && json.accessToken) {",
         "  pm.collectionVariables.set('token', json.accessToken);",
         "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
         "  if (json.user) pm.collectionVariables.set('memberId', json.user.id);",
         "  if (json.tenant) pm.collectionVariables.set('tenantId', json.tenant.id);",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Logout",
     "request": {
      "method": "POST",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/auth/logout",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "logout"
       ]
      },
      "description": "Revokes the session refresh tokens. 204."
     },
     "response": []
    },
    {
     "name": "Request password reset",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/password-reset",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "password-reset"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"member@kedemlife.app\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      },
      "description": "Always 204, even for unknown addresses."
     },
     "response": []
    },
    {
     "name": "Confirm password reset",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/password-reset/confirm",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "password-reset",
        "confirm"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"token\": \"paste-token-from-email-link\",\n  \"password\": \"newlongpassword\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      },
      "description": "204 on success; 400 reset_invalid when the token is unknown, used or older than 30 min. Revokes every session."
     },
     "response": []
    },
    {
     "name": "Change password",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/change-password",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "change-password"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"currentPassword\": \"kedemlife\",\n  \"newPassword\": \"longenough2\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "description": "204 on success; 400 invalid_credentials when currentPassword is wrong."
     },
     "response": []
    }
   ]
  },
