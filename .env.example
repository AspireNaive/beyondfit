# Copy to `.env.local` and adjust. All values are optional — the defaults run
# the app entirely against the in-memory adapter with no backend.

# 'http' (default) talks to the Node API in ./server.
# 'mock'  uses the in-memory adapter and seed data — UI work without a database.
VITE_API_MODE=http

# Base URL for the API. Defaults to '/api', which the Vite dev server proxies
# to VITE_API_PROXY_TARGET so the browser stays same-origin. When the site and
# the API are on different hosts, set the full origin, e.g.
# VITE_KEDEM_API_URL=https://api.example.com/api — and add that origin to
# connect-src in vercel.json / firebase.json. (Not VITE_API_URL: GoDaddy Node.js
# Hosting injects that name with the preview app's address at build time.)
VITE_KEDEM_API_URL=/api

# Where the dev server proxies '/api' to: the Node API from `npm run dev` in ./server.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Artificial latency (ms) for the mock adapter, so loading states are visible.
VITE_MOCK_LATENCY=260

# Optional CDN URL for the homepage hero video. If unset the hero looks for
# /media/hero.webm and /media/hero.mp4, and falls back to a CSS backdrop.
# VITE_HERO_VIDEO_URL=https://cdn.example.com/beyondfit/hero.mp4
