# Copy to .env. Every value has a sane default except JWT_SECRET and the DB.

NODE_ENV=development
PORT=4000
# Optional interface to bind (e.g. 127.0.0.1 behind a local reverse proxy).
# HOST=
LOG_LEVEL=info

# --- Database (GoDaddy cPanel → MySQL Databases; enable Remote MySQL for the
# --- host the API runs on, or run the API on the same hosting account).
# Either one URL …
# DATABASE_URL=mysql://user:password@host:3306/database
# … or the parts.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kedem_life
DB_SSL=false
DB_POOL_SIZE=5

# --- Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Web. Comma-separated origins allowed to call the API from a browser.
# Leave empty when the API serves the built front end itself (same origin).
CORS_ORIGINS=http://localhost:5173
# Serve ../dist (the Vite build) from this process: one deployment, no CORS.
SERVE_STATIC=false
STATIC_DIR=../dist
# Where password-reset links point.
APP_URL=http://localhost:5173
# Set to 1 behind a reverse proxy (cPanel/Passenger, Nginx) so rate limiting
# and logs see the real client IP.
TRUST_PROXY=0

# --- Email (optional). Without SMTP, reset links are written to the log.
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=
# SMTP_FROM="Kedem Life <noreply@yourdomain.com>"

# --- Payments. 'manual' records a succeeded payment without a gateway.
PAYMENT_PROVIDER=manual

# --- Bootstrap (db:bootstrap creates the first tenant + admin from these).
BOOTSTRAP_TENANT_NAME=Kedem Life
BOOTSTRAP_TENANT_SLUG=kedem
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
