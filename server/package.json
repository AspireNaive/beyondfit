{
  "name": "kedem-life-api",
  "version": "0.1.0",
  "private": true,
  "description": "Kedem Life REST API — Node.js/Express on Cloud Firestore",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:posts": "tsx scripts/seed-posts.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "test": "firebase emulators:exec --only firestore --project demo-kedem --config ../firebase.json \"vitest run\"",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only firestore --project demo-kedem --config ../firebase.json --import ../.firestore-emulator --export-on-exit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@date-fns/tz": "^1.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-static-gzip": "^3.0.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "typescript": "^5.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "firebase-tools": "^15.26.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
